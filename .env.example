# Template only. Export these in the service environment, or on Node 20.6+
# run with --env-file=.env. Never commit real values.
# Only the Discord bot needs these; scanner.js reads its two variables directly.

# --- bot/index.js ---------------------------------------------------------
# Bot token from the Discord developer portal. Treat it like a password.
DISCORD_TOKEN=

# Register slash commands in one guild (instant) instead of globally (slow).
DISCORD_GUILD_ID=

# Access control. Set at least one, or the bot refuses to start.
# Comma-separated IDs, not names.
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ALLOWED_USER_IDS=

# Folder the bot may scan. /scan cannot escape this directory.
SCAN_ROOT=./resources

# --- scanner.js -----------------------------------------------------------
# Optional: post every scan report to this webhook.
# Placeholder only — paste your OWN webhook URL. The URL is a credential:
# anyone holding it can post to the channel, so never commit a real one.
SOURCELOCK_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-with-your-own-webhook-token

# Trust list shared by the scanner and the bot.
SOURCELOCK_TRUST_FILE=./sourcelock-trust.json
